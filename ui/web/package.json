{
  "name": "mycelium-network-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:live": "tsc -b && VITE_OBSERVATORY_SOURCE_MODE=live vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:watch": "vitest",
    "test:contracts": "node --test scripts/contract-diff.test.mjs",
    "test:interactive-contract": "node --test scripts/operator-contract.test.mjs",
    "test:a8-browser-evidence": "node --test scripts/a8-browser-evidence.test.mjs",
    "test:interactive-bundle": "node scripts/check-interactive-bundle.mjs",
    "test:interactive-multibrowser": "node scripts/interactive-multibrowser-e2e.mjs",
    "test:a4-live-browser": "node scripts/a4-product-browser-e2e.mjs",
    "test:a5-live-browser": "node scripts/a5-product-browser-e2e.mjs",
    "test:a6-browser-harness": "node --test scripts/a6-product-browser-e2e.test.mjs",
    "test:a6-browser-matrix": "node --test scripts/a6-product-browser-matrix.test.mjs",
    "test:a6-live-browser": "node scripts/a6-product-browser-e2e.mjs",
    "test:a6-serve-factory": "node --test scripts/a6-serve-receiver-factory.test.mjs",
    "test:a6-live-matrix": "node scripts/a6-serve-receiver-factory.mjs",
    "test:a14-live-browser": "node scripts/a14-live-browser.mjs",
    "test:a14-live-browser-harness": "node --test scripts/a14-live-browser.test.mjs",
    "test:navigation-polls": "node scripts/navigation-poll-browser.mjs",
    "test:a10-browser-sessions": "node scripts/a10-browser-sessions.mjs",
    "test:a10-browser-sessions-harness": "node --test scripts/a10-browser-sessions.test.mjs",
    "test:e2e": "PLAYWRIGHT_NO_COPY_PROMPT=1 VITE_OBSERVATORY_SOURCE_MODE=fixture npm run build && PLAYWRIGHT_NO_COPY_PROMPT=1 playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "contracts:diff": "node scripts/contract-diff.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm test && npm run test:contracts && npm run test:interactive-contract && npm run test:a8-browser-evidence && npm run test:interactive-bundle && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "elkjs": "^0.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "8.20.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
