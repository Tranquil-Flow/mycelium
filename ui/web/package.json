{
  "name": "mycelium-network-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:live": "tsc -b && VITE_OBSERVATORY_SOURCE_MODE=live vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:watch": "vitest",
    "test:contracts": "node --test scripts/contract-diff.test.mjs",
    "test:interactive-contract": "node --test scripts/operator-contract.test.mjs",
    "test:interactive-bundle": "node scripts/check-interactive-bundle.mjs",
    "test:interactive-multibrowser": "node scripts/interactive-multibrowser-e2e.mjs",
    "test:e2e": "PLAYWRIGHT_NO_COPY_PROMPT=1 npm run build && PLAYWRIGHT_NO_COPY_PROMPT=1 playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "contracts:diff": "node scripts/contract-diff.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm test && npm run test:contracts && npm run test:interactive-contract && npm run test:interactive-bundle && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "elkjs": "^0.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "8.20.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
