{
  "protocol": "mycelium.a8_acceptance_inventory.v1",
  "gate": "A8",
  "state": "design_only",
  "claim_boundary": "frozen infrastructure decisions and future acceptance inputs only; no implementation, network contact, physical evidence, readiness, or completion claim",
  "source_specification": "docs/superpowers/specs/2026-08-18-mycelium-a8-internet-native-control.md",
  "decisions": [
    {
      "decision_id": "public_https_bootstrap_authentication",
      "decision": "publicly trusted TLS authenticates the canonical host while signed seed identity, an invitation-bound seed-key pin, single-use join secret, and signed post-join member envelopes own Mycelium authority",
      "authorities": ["public_tls_hostname", "pinned_seed_verification_key", "single_use_invitation", "signed_member_envelope"],
      "required_acceptance": ["closed_public_route_allowlist", "seed_signature_required_after_tls", "invite_secret_body_only", "post_join_control_requires_member_signature"],
      "forbidden_fallbacks": ["cleartext_http", "redirect_following", "tls_only_membership_authority", "public_operator_administration", "cookie_or_bearer_membership"]
    },
    {
      "decision_id": "seed_key_pinning",
      "decision": "the invitation pins the sha256 digest of canonical ed25519 seed verification-key bytes before secret transmission and rotation requires a dual-signed monotonic transition with bounded overlap",
      "authorities": ["invitation_seed_key_digest", "signed_seed_identity", "dual_signed_seed_transition", "monotonic_seed_generation"],
      "required_acceptance": ["pin_checked_before_secret_transmission", "wrong_pin_rejected", "valid_overlap_rotation_accepted", "expired_or_rollback_rotation_rejected"],
      "forbidden_fallbacks": ["trust_on_first_use", "certificate_key_as_seed_key", "hostname_only_seed_trust", "silent_repin"]
    },
    {
      "decision_id": "invitation_and_revocation",
      "decision": "owner-private administration mints bounded class-scoped expiring single-use invitations and revocation advances signed authority for both control and activation admission",
      "authorities": ["owner_private_invite_authority", "atomic_invitation_consumption", "signed_membership_generation", "activation_admission_revocation"],
      "required_acceptance": ["one_exact_join_or_idempotent_retry", "no_partial_member_on_rejection", "revoked_control_rejected", "revoked_open_activation_removed"],
      "forbidden_fallbacks": ["public_invite_minting", "reusable_invitation", "partial_member_creation", "lease_extension_after_revocation", "revoked_connection_survival"]
    },
    {
      "decision_id": "iroh_direct_relay_activation",
      "decision": "activation uses current membership-authorized endpoint ids and reports direct relay unknown and transitions only from the bound live iroh connection",
      "authorities": ["signed_endpoint_membership", "authenticated_iroh_connection", "connection_generation", "live_path_observation"],
      "required_acceptance": ["endpoint_id_exact_match", "direct_observed_not_inferred", "forced_relay_observed_not_configured", "transition_and_reuse_generation_bound"],
      "forbidden_fallbacks": ["address_only_trust", "operator_typed_endpoint_id", "os_or_network_path_inference", "http_or_websocket_inference"]
    },
    {
      "decision_id": "unknown_not_zero_measurements",
      "decision": "path class and all path metrics are nullable and missing stale rejected or unmeasured values remain unknown while numeric zero requires a current explicit measured sample",
      "authorities": ["bound_activation_observation", "measurement_sample_count", "measurement_generation", "measurement_freshness"],
      "required_acceptance": ["missing_metrics_remain_unknown", "stale_metrics_remain_unknown", "zero_loss_requires_current_samples", "unknown_cannot_satisfy_required_objective"],
      "forbidden_fallbacks": ["default_zero_coercion", "participation_derived_connectivity", "same_lan_direct_inference", "different_network_relay_inference"]
    },
    {
      "decision_id": "privacy_safe_relay_projection",
      "decision": "relay projection exposes only a versioned domain-separated hmac-sha256 stable reference and reviewed coarse region or unknown using an owner-private persistent projection key",
      "authorities": ["owner_private_projection_key", "canonical_relay_identity", "versioned_domain_separator", "reviewed_coarse_region"],
      "required_acceptance": ["stable_reference_for_same_relay", "different_relay_reference_separation", "unknown_region_preserved", "raw_relay_identity_rejected"],
      "forbidden_fallbacks": ["raw_relay_url", "relay_dns_or_ip", "relay_port_or_credentials", "reversible_hash", "exact_location_projection"]
    },
    {
      "decision_id": "ssh_tailscale_independence",
      "decision": "supported bootstrap activation measurement qualification and serving require neither tailscale nor ssh and ssh remains only an optional owner-labelled staging tool",
      "authorities": ["public_https_origin", "authenticated_iroh_transport", "signed_artifact_grant", "ordinary_internet_reachability"],
      "required_acceptance": ["tailscale_disabled_before_join", "no_tailnet_address_or_evidence", "ssh_absent_on_external_peer", "no_remote_shell_or_hidden_copy_dependency"],
      "forbidden_fallbacks": ["tailnet_fallback", "tailscale_measurement_authority", "ssh_enrollment", "ssh_serving", "full_model_copy_fallback"]
    }
  ],
  "workspace_projections": {
