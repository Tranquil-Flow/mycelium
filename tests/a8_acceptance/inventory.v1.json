      "forbidden_fallbacks": [
        "address_only_trust",
        "operator_typed_endpoint_id",
        "os_or_network_path_inference",
        "http_or_websocket_inference"
      ],
      "required_acceptance": [
        "endpoint_id_exact_match",
        "direct_observed_not_inferred",
        "forced_relay_observed_not_configured",
        "transition_and_reuse_generation_bound"
      ]
    },
    {
      "authorities": [
        "bound_activation_observation",
        "measurement_sample_count",
        "measurement_generation",
        "measurement_freshness"
      ],
      "decision": "path class and all path metrics are nullable and missing stale rejected or unmeasured values remain unknown while numeric zero requires a current explicit measured sample",
      "decision_id": "unknown_not_zero_measurements",
      "forbidden_fallbacks": [
        "default_zero_coercion",
        "participation_derived_connectivity",
