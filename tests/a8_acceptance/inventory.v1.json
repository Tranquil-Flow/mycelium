      "decision_id": "invitation_and_revocation",
      "forbidden_fallbacks": [
        "public_invite_minting",
        "reusable_invitation",
        "partial_member_creation",
        "lease_extension_after_revocation",
        "revoked_connection_survival"
      ],
      "required_acceptance": [
        "one_exact_join_or_idempotent_retry",
