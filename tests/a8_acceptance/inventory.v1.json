{
  "claim_boundary": "frozen A8 acceptance decisions plus privacy-reduced retained proof of 14 source/spec-bound executed physical and ordinary-browser cases; final completion additionally requires post-document regressions, audits, handover closure, and the atomic feature commit",
  "decisions": [
    {
      "authorities": [
        "public_tls_hostname",
        "pinned_seed_verification_key",
        "single_use_invitation",
        "signed_member_envelope"
      ],
      "decision": "publicly trusted TLS authenticates the canonical host while signed seed identity, an invitation-bound seed-key pin, single-use join secret, and signed post-join member envelopes own Mycelium authority",
      "decision_id": "public_https_bootstrap_authentication",
      "forbidden_fallbacks": [
        "cleartext_http",
        "redirect_following",
        "tls_only_membership_authority",
        "public_operator_administration",
        "cookie_or_bearer_membership"
      ],
      "required_acceptance": [
        "closed_public_route_allowlist",
        "seed_signature_required_after_tls",
        "invite_secret_body_only",
        "post_join_control_requires_member_signature"
      ]
    },
    {
      "authorities": [
        "invitation_seed_key_digest",
        "signed_seed_identity",
        "dual_signed_seed_transition",
        "monotonic_seed_generation"
      ],
      "decision": "the invitation pins the sha256 digest of canonical ed25519 seed verification-key bytes before secret transmission and rotation requires a dual-signed monotonic transition with bounded overlap",
      "decision_id": "seed_key_pinning",
      "forbidden_fallbacks": [
        "trust_on_first_use",
        "certificate_key_as_seed_key",
        "hostname_only_seed_trust",
        "silent_repin"
      ],
      "required_acceptance": [
        "pin_checked_before_secret_transmission",
