      ],
      "decision": "relay projection exposes only a versioned domain-separated hmac-sha256 stable reference and reviewed coarse region or unknown using an owner-private persistent projection key",
      "decision_id": "privacy_safe_relay_projection",
      "forbidden_fallbacks": [
