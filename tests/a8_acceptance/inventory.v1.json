  "physical_positive_cases": [
    {
      "case_id": "unrelated_https_invite_without_tailscale",
      "gate_kind": "physical_positive",
      "setup": "external native peer is on an unrelated network with tailscale disabled and a current owner-delivered invite",
      "stimulus": "verify public https seed pin redeem invite renew membership and project ineligibility",
      "required_outcomes": ["https_bootstrap_succeeds", "seed_pin_verified", "signed_member_visible_but_ineligible"],
      "forbidden_side_effects": ["tailnet_fallback", "tls_only_membership_authority", "serving_eligibility_created"]
    },
    {
      "case_id": "direct_path_qualified_browser_inference",
      "gate_kind": "physical_positive",
      "setup": "current signed capabilities assigned artifacts and direct iroh observation qualify one exact external role",
      "stimulus": "submit an ordinary browser request through the selected qualified route",
      "required_outcomes": ["direct_path_observed", "browser_inference_completes", "positive_physical_counters"],
      "forbidden_side_effects": ["configured_path_claimed_observed", "direct_path_inferred", "unqualified_member_serves"]
    },
    {
      "case_id": "forced_relay_privacy_reduced_browser_inference",
      "gate_kind": "physical_positive",
      "setup": "reviewed transport control forces relay while exact role qualification and browser gateway authority remain current",
      "stimulus": "complete another ordinary browser inference and inspect the public relay projection",
      "required_outcomes": ["relay_path_observed", "browser_inference_completes", "privacy_safe_relay_reference_only"],
      "forbidden_side_effects": ["raw_relay_identity_emitted", "forced_setting_claimed_as_observation", "http_inference_fallback"]
    },
    {
      "case_id": "observed_path_transition_and_reconnect",
      "gate_kind": "physical_positive",
      "setup": "one current qualified path changes between direct and relay across bound connection generations",
      "stimulus": "observe transition persistent reuse bounded reconnect and a subsequent browser request",
      "required_outcomes": ["transition_generations_retained", "connection_reuse_observed", "subsequent_request_completes"],
      "forbidden_side_effects": ["prior_observation_rewritten", "stale_connection_reused", "route_state_fabricated"]
    }
  ],
  "physical_negative_cases": [
    {
      "case_id": "cleartext_or_redirect_bootstrap",
      "gate_kind": "physical_negative",
      "setup": "external peer has no tailscale path and receives only the canonical https origin",
      "stimulus": "attempt cleartext http downgrade redirect or a non-allowlisted bootstrap route",
      "required_outcomes": ["request_rejected", "no_cleartext_fallback", "bounded_public_error"],
      "forbidden_side_effects": ["invite_secret_transmitted", "member_created", "route_mutated"]
    },
    {
      "case_id": "certificate_without_seed_authority",
      "gate_kind": "physical_negative",
      "setup": "tls hostname validation succeeds but seed signature or invitation seed-key pin is wrong",
      "stimulus": "fetch seed identity before join",
      "required_outcomes": ["seed_pin_mismatch_before_invite_transmission", "join_not_attempted", "bounded_incident_only"],
      "forbidden_side_effects": ["invite_secret_transmitted", "silent_repin", "member_created"]
    },
    {
      "case_id": "invalid_or_replayed_invitation",
      "gate_kind": "physical_negative",
      "setup": "invite is expired reused forged wrong-swarm wrong-seed or changed under the same retry identity",
      "stimulus": "submit canonical join request",
      "required_outcomes": ["join_rejected", "no_partial_member", "single_use_state_not_corrupted"],
      "forbidden_side_effects": ["membership_generation_advanced", "artifact_grant_created", "route_mutated"]
    },
    {
      "case_id": "revoked_active_member",
      "gate_kind": "physical_negative",
