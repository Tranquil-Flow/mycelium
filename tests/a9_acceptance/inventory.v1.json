  "acceptance_cases": [
    {
      "case_id": "authority_dimension_independence",
      "gate_kind": "deterministic_negative",
      "setup": "a current signed member changes one declared platform transport runtime or capability dimension",
      "stimulus": "recompute profile evidence qualification and eligibility bindings",
      "required_outcomes": ["changed_dimension_generation_advances", "dependent_eligibility_withdrawn", "independent_authorities_unchanged"],
      "forbidden_side_effects": ["other_dimension_rewritten", "placement_created", "route_readiness_granted"]
    },
    {
      "case_id": "signed_capability_tamper_or_staleness",
      "gate_kind": "deterministic_negative",
      "setup": "capability report is unsigned tampered expired or bound to another profile generation or incarnation",
      "stimulus": "validate the report for class qualification",
      "required_outcomes": ["capability_report_rejected", "eligibility_remains_ineligible", "bounded_reason_recorded"],
      "forbidden_side_effects": ["profile_mutated", "qualification_issued", "membership_lease_extended"]
    },
    {
      "case_id": "unknown_future_platform_or_runtime",
      "gate_kind": "deterministic_negative",
      "setup": "profile uses the registered unknown sentinel or an unrecognized enum protocol field or class",
      "stimulus": "validate and project the peer profile",
      "required_outcomes": ["registered_unknown_visible_and_ineligible", "explicit_unknown_blocker", "unrecognized_value_rejected"],
      "forbidden_side_effects": ["unknown_coerced_to_supported", "zero_or_healthy_fabricated", "activation_admitted"]
    },
    {
      "case_id": "synthetic_native_substitution",
      "gate_kind": "deterministic_negative",
      "setup": "synthetic conformance passes while the role requires fresh native-observed evidence",
      "stimulus": "request class qualification and render eligibility",
      "required_outcomes": ["synthetic_evidence_retained_separately", "native_gate_remains_open", "source_kind_visible"],
      "forbidden_side_effects": ["synthetic_promoted_to_native", "native_qualification_issued", "source_kind_hidden"]
    },
    {
      "case_id": "identity_continuity_v2_migration",
      "gate_kind": "physical_positive",
      "setup": "a current non-revoked legacy member proves possession of its durable node key during bounded migration",
      "stimulus": "commit its v2 profile through the restart-safe migration checkpoint",
      "required_outcomes": ["node_id_and_verification_key_preserved", "new_incarnation_created", "generation_advances_exactly_once", "member_visible_but_roles_re_evaluating"],
      "forbidden_side_effects": ["legacy_history_rewritten", "duplicate_member_created", "eligibility_carried_over"]
    },
    {
      "case_id": "identity_discontinuity_migration",
      "gate_kind": "physical_negative",
      "setup": "legacy member is stale revoked changed-key ambiguous or cannot prove durable identity continuity",
      "stimulus": "attempt v2 migration without a fresh invitation",
      "required_outcomes": ["migration_rejected", "fresh_reenrollment_required", "prior_database_preserved"],
      "forbidden_side_effects": ["operator_identity_mapping_used", "partial_v2_member_visible", "incumbent_displaced"]
    },
    {
      "case_id": "eligibility_carry_over_rejection",
      "gate_kind": "physical_negative",
      "setup": "legacy member had prior activation eligibility but has not passed exact v2 profile and class re-evaluation",
      "stimulus": "request assignment artifact activation registration and selection",
      "required_outcomes": ["legacy_eligibility_not_copied", "member_visible_and_ineligible", "incumbent_remains_recoverable"],
      "forbidden_side_effects": ["assignment_created", "artifact_disclosed", "activation_admitted", "deployment_selected"]
    },
    {
      "case_id": "v1_write_after_cutover",
      "gate_kind": "deterministic_negative",
      "setup": "recorded cutover is complete and the bounded v1 transition reader is no longer authoritative",
      "stimulus": "send v1 renewal capability assignment or readiness input",
      "required_outcomes": ["v1_write_rejected", "upgrade_required_reason", "v2_generation_unchanged"],
      "forbidden_side_effects": ["dual_write_created", "v2_lease_renewed", "migration_reader_reenabled"]
    },
    {
      "case_id": "role_specific_qualification_isolation",
      "gate_kind": "deterministic_negative",
      "setup": "peer holds a current qualification for one role but requests a different role",
      "stimulus": "derive eligibility and request downstream authority",
      "required_outcomes": ["qualified_role_unchanged", "unqualified_role_rejected", "role_specific_blocker_visible"],
      "forbidden_side_effects": ["cross_role_grant", "placement_created", "route_readiness_granted"]
    },
    {
      "case_id": "windows_accelerated_physical_positive",
      "gate_kind": "physical_positive",
      "setup": "a native Windows x86_64 member has an exact candidate provider build and the qualified Qwen int8 stage",
      "stimulus": "run the frozen reference and accelerated product benchmark with native observations",
      "required_outcomes": ["windows_acceleration_qualified", "performance_role_earned", "token_output_parity", "a10_prerequisite_satisfied"],
      "forbidden_side_effects": ["platform_only_qualification", "reference_backend_promoted", "threshold_changed_after_measurement"]
    },
    {
      "case_id": "numpy_reference_not_performance_eligible",
      "gate_kind": "deterministic_negative",
      "setup": "a Windows member exposes portable NumPy or an installed provider without physical acceleration evidence",
      "stimulus": "request performance-ready stage eligibility and A10 readiness",
      "required_outcomes": ["correctness_role_retained", "performance_role_rejected", "a10_remains_blocked"],
      "forbidden_side_effects": ["numpy_as_acceleration", "package_presence_promoted", "deployment_selection_changed"]
    },
    {
      "case_id": "int8_decode_materialization_rejection",
      "gate_kind": "physical_negative",
      "setup": "candidate stores int8 weights but casts or repacks complete matrices during each warm decode operation",
      "stimulus": "execute the materialization and bounded-workspace challenge window",
      "required_outcomes": ["materialization_detected", "performance_role_rejected", "correctness_evidence_unchanged"],
      "forbidden_side_effects": ["storage_quantization_promoted", "unbounded_workspace_accepted", "a10_prerequisite_satisfied"]
    },
    {
      "case_id": "reduced_precision_activation_qualification",
      "gate_kind": "physical_positive",
      "setup": "adjacent exact runtime builds advertise one common reduced precision activation codec",
      "stimulus": "run parity byte reduction replay cancellation and corruption gates on the physical edge",
      "required_outcomes": ["activation_codec_qualified", "activation_bytes_reduced", "committed_tokens_match_reference", "cleanup_remains_exact"],
      "forbidden_side_effects": ["silent_dtype_coercion", "private_activation_exposed", "unqualified_codec_selected"]
    },
    {
      "case_id": "activation_codec_withdrawal",
      "gate_kind": "physical_negative",
      "setup": "the codec evidence is stale mismatched corrupted nonfinite or unsupported by one adjacent runtime build",
      "stimulus": "attempt activation admission and reconnect through the changed edge generation",
      "required_outcomes": ["codec_admission_rejected", "performance_readiness_withdrawn", "qualified_fallback_explicit"],
      "forbidden_side_effects": ["stale_codec_reused", "corrupt_frame_executed", "silent_precision_downgrade"]
    },
    {
      "case_id": "component_cost_and_single_request_floor",
      "gate_kind": "physical_positive",
      "setup": "the frozen paired corpus has exact component edge thermal and workload identities before candidate observation",
      "stimulus": "measure component costs replan and evaluate the declared single request confidence thresholds",
      "required_outcomes": ["vocabulary_head_cost_measured", "compute_transport_costs_separate", "planner_prediction_error_reported", "single_request_floor_passed"],
      "forbidden_side_effects": ["equal_layer_cost_used", "aggregate_throughput_substituted", "failed_sample_excluded_silently", "threshold_changed_after_measurement"]
    },
    {
      "case_id": "dynamic_projection_withdrawal",
      "gate_kind": "browser_positive",
      "setup": "live profile build evidence freshness or class qualification changes for a visible member",
      "stimulus": "refresh navigate reconnect and open a clean second browser session",
      "required_outcomes": ["all_workspaces_share_new_generation", "withdrawal_visible_without_reload_state", "source_freshness_and_blockers_visible", "second_session_reconstructs_same_public_truth"],
      "forbidden_side_effects": ["browser_state_preserves_eligibility", "stale_generation_rendered_current", "private_device_detail_exposed"]
    },
    {
      "case_id": "dynamic_unknown_registry_value",
      "gate_kind": "browser_negative",
      "setup": "a registered future unknown platform transport runtime or capability value appears without qualification",
      "stimulus": "project it through every applicable workspace",
      "required_outcomes": ["value_rendered_without_brand_branch", "unknown_ineligible_blocker_visible", "no_hard_coded_inventory_change_required"],
      "forbidden_side_effects": ["value_hidden", "compound_legacy_label_rendered", "eligibility_inferred"]
    }
