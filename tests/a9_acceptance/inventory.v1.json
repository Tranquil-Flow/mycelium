    {
      "workspace_id": "readiness",
      "required_projection": ["membership_proof", "profile_proof", "evidence_proof", "class_qualification", "artifact_proof", "load_proof", "deployment_qualification", "registration", "selection"],
      "dynamic_behavior": ["proofs_independently_fresh", "dependent_withdrawal_live", "same_public_generation"],
      "forbidden_claims": ["peer_qualification_is_route_ready", "membership_is_stage_ready"]
    },
    {
      "workspace_id": "incidents",
      "required_projection": ["migration_state", "stale_profile", "changed_build", "unsupported_capability", "eligibility_withdrawal"],
      "dynamic_behavior": ["terminal_history_retained", "bounded_reason_codes", "reconnect_reconstructs"],
      "forbidden_claims": ["private_device_detail", "fabricated_peer_failure"]
    },
    {
      "workspace_id": "settings",
      "required_projection": ["contract_versions", "supported_registries", "contribution_policy", "privacy_retention", "migration_status", "revocation"],
      "dynamic_behavior": ["registry_updates_without_ui_inventory_edit", "redacted_diagnostics", "same_public_generation"],
      "forbidden_claims": ["private_membership_credential", "operator_mapping_as_identity"]
    }
  ]
}
