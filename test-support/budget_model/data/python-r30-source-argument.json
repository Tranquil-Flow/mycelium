  "lines": {
    "195": "    def _challenge_event(self, deployment_id, request_id, kind, index, limit):",
    "196": "        # Only the supervisor's verified-route sink supplies token indices.",
    "197": "        # Never call a user callback, do RPC, or retain token values under this lock.",
    "198": "        import re",
    "199": "        with self._lock:",
    "200": "            if (self.stop_event.is_set() or self._state!='starting'",
    "201": "                    or self._progress_identity is None",
    "202": "                    or deployment_id!=self._progress_identity[1]",
    "203": "                    or type(request_id) is not str",
    "204": "                    or len(request_id)!=40",
    "205": "                    or re.fullmatch(r'startup-[0-9a-f]{32}',request_id) is None",
    "206": "                    or type(limit) is not int or not 0 < limit <= 4096):",
    "207": "                return",
    "208": "            if kind=='begin' and index == -1:",
    "209": "                if self._challenge_request is None:",
    "210": "                    self._challenge_request=request_id",
    "211": "                    self._challenge_limit=limit",
    "212": "                return",
    "213": "            if (kind=='token' and request_id==self._challenge_request",
    "214": "                    and limit==self._challenge_limit and type(index) is int",
    "215": "                    and index==self._challenge_count and index<limit):",
    "216": "                self._challenge_count+=1",
    "242": "                'challenge_progress':({'verified_token_count':self._challenge_count}",
    "332": "                **({'on_challenge_event':self._challenge_event}",
    "333": "                   if self._progress_identity is not None else {}))"
  }
